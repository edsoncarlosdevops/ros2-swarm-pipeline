{
    "name": "ROS 2 Swarm Pipeline Dev Environment",
    "image": "ros:jazzy-ros-base",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-vscode.cpptools",
                "ms-vscode.cmake-tools",
                "twxs.cmake",
                "ms-azuretools.vscode-docker"
            ]
        }
    },
    "forwardPorts": [],
    "postCreateCommand": "pip install --user colcon-common-extensions ccache && apt-get update && apt-get install -y ccache",
    "remoteUser": "root",
    "workspaceMount": "source=${localWorkspaceFolder},target=/ros2_ws/src/ros2-swarm-pipeline,type=bind",
    "workspaceFolder": "/ros2_ws"
}